rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function me() { return get(userPath(request.auth.uid)).data; }
    function hasRole(role) { return signedIn() && me().role == role; }
    function inOffice(officeId) {
      return signedIn() && me().officeId == officeId;
    }
    function isUnlinkedProfile(profileData) {
      return !('officeId' in profileData)
        || profileData.officeId == null
        || profileData.officeId == '';
    }
    function officeManager(officeId) {
      return inOffice(officeId) && me().role == 'manager';
    }
    function projectMember(projectId) {
      return signedIn() && me().projectIds is list && projectId in me().projectIds;
    }
    function managerCompletingOwnedOffice(uid) {
      return resource.data.role == 'manager'
        && resource.data.get('onboardingComplete', false) == false
        && request.resource.data.onboardingComplete == true
        && request.resource.data.officeId is string
        && request.resource.data.projectIds is list
        && request.resource.data.projectIds.size() == 0
        && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)).data.officeId == request.resource.data.officeId;
    }
    function visibleToMe() {
      return resource.data.visibleTo is list && request.auth.uid in resource.data.visibleTo;
    }
    function canReadOfficeRecord(officeId, collectionName) {
      return officeManager(officeId)
        || (collectionName == 'consultants' && inOffice(officeId))
        || (collectionName == 'team' && inOffice(officeId) && hasRole('pm'))
        || (collectionName == 'teams' && inOffice(officeId) && hasRole('pm') && visibleToMe())
        || (collectionName == 'consultantSlots' && inOffice(officeId)
          && (resource.data.requestedByUid == request.auth.uid || resource.data.consultantUid == request.auth.uid))
        || (collectionName == 'joinRequests' && (officeManager(officeId) || resource.data.uid == request.auth.uid))
        || (collectionName == 'notifications' && resource.data.recipientUid == request.auth.uid)
        || (collectionName == 'consultations' && inOffice(officeId)
          && resource.data.consultantUid == request.auth.uid)
        || (inOffice(officeId) && visibleToMe()
          && (!('projectId' in resource.data) || resource.data.projectId == ''
            || projectMember(resource.data.projectId)));
    }
    function managerOrProjectManager(officeId, projectId) {
      return officeManager(officeId)
        || (inOffice(officeId) && hasRole('pm') && projectMember(projectId));
    }

    function validInviteCode(inviteCode) {
      return inviteCode.matches('^KHALIYA-INV-[A-F0-9]{8}$');
    }
    function inviteEmailMatches(email) {
      return signedIn() && email is string && request.auth.token.email is string
        && email.lower() == request.auth.token.email.lower();
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['manager', 'pm', 'engineer', 'client', 'consultant']
        && request.resource.data.userCode == 'KHL-' + uid;
      allow read: if (signedIn() && request.auth.uid == uid)
        || (signedIn() && me().role == 'manager' && (me().officeId == resource.data.officeId
          || (isUnlinkedProfile(resource.data)
            && get(/databases/$(database)/documents/offices/$(me().officeId)/joinRequests/$(uid)).data.status == 'pending')));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.userCode == resource.data.userCode
        && (
          request.resource.data.officeId == resource.data.officeId
          || (request.resource.data.officeId is string
            && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)).data.ownerUid == uid)
          || (request.resource.data.inviteCode is string
            && getAfter(/databases/$(database)/documents/publicInvites/$(request.resource.data.inviteCode)).data.get('acceptedBy', '') == uid
            && getAfter(/databases/$(database)/documents/publicInvites/$(request.resource.data.inviteCode)).data.officeId == request.resource.data.officeId
            && inviteEmailMatches(getAfter(/databases/$(database)/documents/publicInvites/$(request.resource.data.inviteCode)).data.email)
            && getAfter(/databases/$(database)/documents/publicInvites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role)
        )
        && (request.resource.data.projectIds == resource.data.get('projectIds', [])
          || managerCompletingOwnedOffice(uid)
          || (request.resource.data.inviteCode is string
            && getAfter(/databases/$(database)/documents/publicInvites/$(request.resource.data.inviteCode)).data.get('acceptedBy', '') == uid));
      allow update: if signedIn()
        && me().role == 'manager'
        && (me().officeId == resource.data.officeId
          || (request.resource.data.officeId is string && request.resource.data.officeId != '' && me().officeId == request.resource.data.officeId))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.officeId == resource.data.officeId
        && request.resource.data.userCode == resource.data.userCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectIds', 'updatedAt']);
      allow delete: if false;
      allow update: if signedIn()
        && me().role == 'manager'
        && (me().officeId == resource.data.officeId
          || (isUnlinkedProfile(resource.data)
            && request.resource.data.officeId == me().officeId
            && getAfter(/databases/$(database)/documents/offices/$(me().officeId)/joinRequests/$(uid)).data.status == 'accepted'))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.userCode == resource.data.userCode
        && (
          (request.resource.data.officeId == resource.data.officeId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectIds', 'updatedAt']))
          || (isUnlinkedProfile(resource.data)
            && request.resource.data.officeId == me().officeId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['officeId', 'officeName', 'projectIds', 'onboardingComplete', 'inviteCode', 'joinRequestStatus', 'updatedAt'])
            && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)/joinRequests/$(uid)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)/joinRequests/$(uid)).data.uid == uid
            && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)/joinRequests/$(uid)).data.officeId == request.resource.data.officeId
            && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)/joinRequests/$(uid)).data.role == resource.data.role)
          || (resource.data.role != 'manager'
            && request.resource.data.officeId == ''
            && request.resource.data.officeName == ''
            && request.resource.data.projectIds == []
            && request.resource.data.onboardingComplete == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['officeId', 'officeName', 'projectIds', 'onboardingComplete', 'joinRequestStatus', 'updatedAt'])
            && !existsAfter(/databases/$(database)/documents/offices/$(resource.data.officeId)/team/$(uid)))
        );
    }

    match /offices/{officeId} {
      allow create: if signedIn() && hasRole('manager')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.officeId == officeId;
      allow read: if inOffice(officeId);
      allow update: if (
          officeManager(officeId)
          || (signedIn() && hasRole('manager')
            && resource.data.ownerUid == request.auth.uid
            && resource.data.officeId == officeId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['officeId', 'name', 'ownerUid', 'managerUids', 'memberUids', 'city', 'company', 'officeEmail', 'createdAt', 'updatedAt']))
        )
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.officeId == resource.data.officeId;
      allow delete: if false;

      match /{collectionName}/{recordId} {
        allow read: if canReadOfficeRecord(officeId, collectionName);
        allow get: if collectionName == 'joinRequests'
          && signedIn() && recordId == request.auth.uid;
        allow create: if inOffice(officeId)
          && request.resource.data.officeId == officeId
          && request.resource.data.id == recordId
          && request.resource.data.visibleTo is list
          && (
            officeManager(officeId)
            || (collectionName == 'files' && me().role in ['engineer', 'pm', 'client']
              && projectMember(request.resource.data.projectId)
              && request.resource.data.ownerUid == request.auth.uid)
            || (collectionName == 'consultantSlots'
              && me().role in ['manager', 'client', 'engineer', 'pm']
              && (projectMember(request.resource.data.projectId) || officeManager(officeId))
              && request.resource.data.requestedByUid == request.auth.uid
              && get(/databases/$(database)/documents/offices/$(officeId)/consultants/$(request.resource.data.consultantUid)).data.available == true
              && !exists(/databases/$(database)/documents/offices/$(officeId)/consultantSlots/$(recordId)))
            || (collectionName == 'meetingRequests' && hasRole('client')
              && request.resource.data.clientUid == request.auth.uid
              && projectMember(request.resource.data.projectId))
            || (collectionName == 'clientRequests' && hasRole('client')
              && request.resource.data.clientUid == request.auth.uid
              && projectMember(request.resource.data.projectId))
            || (collectionName == 'consultations'
              && me().role in ['client', 'engineer', 'pm', 'manager']
              && request.resource.data.requesterUid == request.auth.uid
              && projectMember(request.resource.data.projectId))
            || (collectionName in ['tasks', 'decisions', 'quantities', 'meetings', 'changes']
              && managerOrProjectManager(officeId, request.resource.data.projectId))
            || (collectionName == 'activity'
              && managerOrProjectManager(officeId, request.resource.data.projectId))
            || (collectionName == 'approvals'
              && managerOrProjectManager(officeId, request.resource.data.projectId))
            || (collectionName == 'notifications'
              && request.resource.data.createdByUid == request.auth.uid
              && projectMember(request.resource.data.projectId))
            || (collectionName == 'teams' && officeManager(officeId)
              && request.resource.data.id == recordId && request.resource.data.visibleTo is list)
            || (collectionName == 'visualProposals' && hasRole('engineer')
              && request.resource.data.employeeUid == request.auth.uid
              && request.resource.data.createdByUid == request.auth.uid
              && projectMember(request.resource.data.projectId)
              && request.resource.data.beforeImage is string
              && request.resource.data.afterImage is string
              && request.resource.data.beforeImage.size() < 380000
              && request.resource.data.afterImage.size() < 380000
              && exists(/databases/$(database)/documents/offices/$(officeId)/tasks/$(request.resource.data.taskId))
              && get(/databases/$(database)/documents/offices/$(officeId)/tasks/$(request.resource.data.taskId)).data.assigneeUid == request.auth.uid)
            || (collectionName == 'team' && recordId == request.auth.uid
              && request.resource.data.uid == request.auth.uid)
            || (collectionName == 'consultants' && recordId == request.auth.uid
              && hasRole('consultant') && request.resource.data.uid == request.auth.uid)
            || (collectionName == 'chat'
              && (officeManager(officeId) || projectMember(request.resource.data.projectId))
              && request.resource.data.authorUid == request.auth.uid)
          );
        allow create: if collectionName == 'joinRequests'
          && signedIn() && recordId == request.auth.uid
          && validJoinRequest(officeId, recordId);
        allow update: if collectionName == 'joinRequests' && signedIn()
          && recordId == request.auth.uid
          && resource.data.uid == request.auth.uid
          && resource.data.status in ['rejected', 'removed']
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'specialty', 'status', 'createdAt', 'reviewedByUid', 'reviewedAt', 'inviteCode', 'managerUids', 'officeName'])
          && validJoinRequest(officeId, recordId);
        allow update: if collectionName == 'joinRequests' && officeManager(officeId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.officeId == officeId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedAt'])
          && ((resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'rejected'])
            || (resource.data.status == 'accepted' && request.resource.data.status == 'removed'
              && getAfter(userPath(resource.data.uid)).data.officeId == ''
              && !existsAfter(/databases/$(database)/documents/offices/$(officeId)/team/$(resource.data.uid))));
        allow create: if collectionName == 'notifications' && signedIn()
          && request.resource.data.id == recordId
          && request.resource.data.officeId == officeId
          && request.resource.data.type == 'join-request'
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.joinRequestUid == request.auth.uid
          && request.resource.data.visibleTo is list
          && request.resource.data.visibleTo == getAfter(/databases/$(database)/documents/offices/$(officeId)/joinRequests/$(request.auth.uid)).data.managerUids
          && getAfter(/databases/$(database)/documents/offices/$(officeId)/joinRequests/$(request.auth.uid)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/offices/$(officeId)/joinRequests/$(request.auth.uid)).data.officeId == officeId;
        allow create: if collectionName == 'notifications' && officeManager(officeId)
          && request.resource.data.id == recordId
          && request.resource.data.officeId == officeId
          && request.resource.data.recipientUid is string
          && request.resource.data.type in ['join-request-approved', 'join-request-rejected', 'member-removed']
          && request.resource.data.visibleTo == [request.resource.data.recipientUid]
          && (request.resource.data.type == 'member-removed'
            ? getAfter(userPath(request.resource.data.recipientUid)).data.officeId == ''
            : getAfter(/databases/$(database)/documents/offices/$(officeId)/joinRequests/$(request.resource.data.recipientUid)).data.status
              == (request.resource.data.type == 'join-request-approved' ? 'accepted' : 'rejected'));
        allow delete: if collectionName == 'joinRequests' && officeManager(officeId);
        allow update: if inOffice(officeId)
          && request.resource.data.officeId == officeId
          && resource.data.id == recordId
          && (
            officeManager(officeId) && (collectionName != 'tasks' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'discipline', 'assigneeUid', 'assignee', 'assigneeName', 'due', 'priority', 'updatedAt', 'visibleTo']))
            || (collectionName == 'tasks' && managerOrProjectManager(officeId, resource.data.projectId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'discipline', 'assigneeUid', 'assignee', 'assigneeName', 'due', 'priority', 'updatedAt', 'visibleTo']))
            || (collectionName in ['decisions', 'changes']
              && managerOrProjectManager(officeId, resource.data.projectId))
            || (collectionName == 'tasks' && hasRole('engineer')
              && projectMember(resource.data.projectId)
              && resource.data.assigneeUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'progress', 'completionNote', 'updatedAt']))
            || (collectionName == 'meetingRequests'
              && managerOrProjectManager(officeId, resource.data.projectId))
            || (collectionName == 'clientRequests'
              && managerOrProjectManager(officeId, resource.data.projectId))
            || (collectionName == 'approvals'
              && managerOrProjectManager(officeId, resource.data.projectId))
            || (collectionName == 'approvals' && hasRole('client')
              && resource.data.clientUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'clientComment', 'updatedAt']))
            || (collectionName == 'visualProposals' && hasRole('engineer')
              && resource.data.employeeUid == request.auth.uid
              && get(/databases/$(database)/documents/offices/$(officeId)/tasks/$(resource.data.taskId)).data.assigneeUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedAt', 'updatedAt']))
            || (collectionName == 'consultations'
              && (resource.data.requesterUid == request.auth.uid
                || resource.data.consultantUid == request.auth.uid))
            || (collectionName == 'consultants' && hasRole('consultant')
              && resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'updatedAt']))
            || (collectionName == 'meetings'
              && managerOrProjectManager(officeId, resource.data.projectId))
            || (collectionName == 'notifications'
              && (resource.data.recipientUid == request.auth.uid
                || request.auth.uid in resource.data.visibleTo)
              && request.resource.data.readBy is list
              && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
              && request.auth.uid in request.resource.data.readBy
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readBy', 'updatedAt']))
            || (collectionName == 'chat' && resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'updatedAt']))
          );
        allow delete: if officeManager(officeId)
          || (collectionName == 'consultantSlots' && inOffice(officeId)
            && resource.data.requestedByUid == request.auth.uid)
          || (collectionName == 'chat' && inOffice(officeId)
            && resource.data.authorUid == request.auth.uid);
      }
    }

    function validJoinRequest(officeId, uid) {
      let requestData = request.resource.data;
      let userData = get(userPath(uid)).data;
      let inviteData = get(/databases/$(database)/documents/publicInvites/$(requestData.inviteCode)).data;
      return signedIn()
        && uid == request.auth.uid
        && requestData.uid == uid
        && requestData.userCode == userData.userCode
        && requestData.email == request.auth.token.email
        && requestData.role == userData.role
        && requestData.role in ['pm', 'engineer', 'client', 'consultant']
        && isUnlinkedProfile(userData)
        && userData.onboardingComplete == false
        && requestData.officeId == officeId
        && requestData.officeName == inviteData.officeName
        && requestData.inviteCode.matches('^KHALIYA-INV-[A-F0-9]{8}$')
        && inviteData.officeId == officeId
        && inviteData.status == 'active'
        && inviteData.scope == 'office'
        && requestData.role in inviteData.allowedRoles
        && requestData.status == 'pending'
        && requestData.managerUids == inviteData.managerUids;
    }

    match /publicInvites/{inviteCode} {
      allow create: if signedIn()
        && validInviteCode(inviteCode)
        && officeManager(request.resource.data.officeId)
        && request.resource.data.keys().hasAll(['id', 'officeId', 'officeName', 'managerUids', 'allowedRoles', 'scope', 'createdByUid', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'officeId', 'officeName', 'managerUids', 'allowedRoles', 'scope', 'createdByUid', 'status', 'createdAt'])
        && request.resource.data.id == inviteCode
        && request.resource.data.scope == 'office'
        && request.resource.data.managerUids is list
        && request.auth.uid in request.resource.data.managerUids
        && request.resource.data.allowedRoles is list
        && request.resource.data.allowedRoles.toSet().hasOnly(['pm', 'engineer', 'client', 'consultant'])
        && request.resource.data.allowedRoles.size() > 0
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'active'
        && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)).data.activeInviteCode == inviteCode;
      allow get: if signedIn()
        && (officeManager(resource.data.officeId)
          || (resource.data.status == 'active'
            && resource.data.scope == 'office'
            && resource.data.id == inviteCode));
      allow list: if signedIn() && officeManager(resource.data.officeId);
      allow update: if signedIn()
        && officeManager(resource.data.officeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedByUid'])
        && resource.data.status == 'active'
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedByUid == request.auth.uid;
      allow delete: if signedIn() && officeManager(resource.data.officeId);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}